[Unit]
Description=Larry web app (next start)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=larry
Group=larry
WorkingDirectory=/opt/larry/current
EnvironmentFile=/etc/larry/env
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
# Bound to localhost: only Caddy reaches it.
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start -p 3000 -H 127.0.0.1
Restart=always
RestartSec=3
# Hardening. The release under /opt/larry is root-owned and read-only (ProtectSystem=strict); the only
# writable place is /var/lib/larry (state, npm cache, and Next's image/route caches, which release.sh
# symlinks there). /etc/larry/env is root-only: systemd reads it before dropping to User=larry.
# No MemoryDenyWriteExecute: V8's JIT needs writable+executable memory.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ReadWritePaths=/var/lib/larry
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
# AF_NETLINK: libuv's os.networkInterfaces() uses it.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0027

[Install]
WantedBy=multi-user.target
