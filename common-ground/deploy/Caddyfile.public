# Public: rendered by caddy-config.sh. Do not edit /etc/caddy/Caddyfile by hand.
# HTTP redirects to HTTPS automatically; the certificate comes from Let's Encrypt.
# The admin API is off, so config changes need `systemctl restart caddy`, not reload.
{
	admin off
}

# One set of response headers for normal and error responses alike.
(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# `?` only fills in what Next did not set, so these also cover responses Caddy writes itself.
		# The CSP lives only in next.config.ts (one place for its dev-only switch).
		?X-Frame-Options "DENY"
		?Permissions-Policy "camera=(self), microphone=(self), geolocation=(self), payment=(), usb=(), browsing-topics=()"
		-Server
		-X-Powered-By
		defer
	}
}

@@HOST@@ {
	encode zstd gzip
	import security_headers
	reverse_proxy 127.0.0.1:3000

	# Errors (the app being down) skip the handlers above, so they get the same headers here.
	handle_errors {
		import security_headers
		header Content-Type "text/plain; charset=utf-8"
		respond "{err.status_code} {err.status_text}"
	}
}
