# Larry environment. Copy to ../.env (common-ground/.env.local links to it) for development.
# Production uses a root-only env file on the server, written by deploy/write-env.sh.
# Never commit real values. Real values live only in .env and on the server, never in the repo.

# ---------------------------------------------------------------- Qloo and Anthropic
QLOO_KEY=
QLOO_SERVER_URL=https://hackathon.api.qloo.com
ANTHROPIC_API_KEY=

# In-app chat spend cap (USD); the hard cap is the Anthropic Console workspace limit
ANTHROPIC_BUDGET_USD=
# Where the spend total is kept. Default: the OS temp folder. Production keeps it in a file under
# /var/lib/larry so it survives deploys.
# ANTHROPIC_SPEND_FILE=/var/lib/larry/anthropic-spend.json
# Access-code store when Upstash is not set. Default: .data/access-codes.json in the app folder.
# ACCESS_CODES_FILE=/var/lib/larry/access-codes.json

# ---------------------------------------------------------------- Amazon Location (D22)
# Opening hours, walking time and multi-stop order for venue picks. Without a key, plans fall back
# to Qloo data and say to check the hours first.
AWS_LOCATION_API_KEY=
AWS_LOCATION_REGION=

# ---------------------------------------------------------------- Firebase
# Public web config, inlined into the browser bundle at BUILD time (so production must have these
# set before `npm run build`; deploy/build.sh loads the server env first).
# Refresh with: npx -y tsx scripts/firebase-setup.ts --dry-run
# No measurementId: the app does not use the Analytics SDK.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# The one demo/testing account (D19): a Firebase test number and its fixed code.
# Real values live only in .env and on the server, never in the repo.
# scripts/firebase-setup.ts sets this as the only test number.
DEMO_PHONE=
DEMO_CODE=

# Server side (firebase-admin). On the VM the service account comes from the metadata server, so
# there is no key file. Locally, `gcloud auth application-default login` gives the same access.
GOOGLE_CLOUD_PROJECT=
# Repository implementation: "memory" (Vitest, Playwright, quick local runs) or "firestore" (production).
# Unset in development: Firestore when Application Default Credentials exist, else memory with a
# console note. Production always uses Firestore. Seed the demo account with
# `npx tsx --conditions=react-server scripts/seed-demo.ts` (needs ADC).
LARRY_DB=memory

# ---------------------------------------------------------------- Open to meet
# Production refuses Open to meet without durable shared storage and a fixed MEET_SECRET, because
# blocks must last for good. Storage: Firestore (Stage 2 adds a Firestore-backed MeetKv selected by
# LARRY_DB=firestore). Upstash Redis (eviction off) also works if both lines below are set.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# 32+ random characters, fixed for good (changing it makes every stored block stop matching).
# Make one with: openssl rand -base64 48
MEET_SECRET=

# ---------------------------------------------------------------- Feature switches
# A podium shows only once this many people are on it.
PODIUM_MIN_PARTICIPANTS=3
# People join a place's podium only when they choose to (D12).
PODIUM_DEFAULT_OPT_IN=false
# Evening Match Day nudge.
MATCHDAY_EVENING=false
# The "lonely without you" gap nudge lines (D7). Off by default.
NUDGE_GAP_LINES=false

# ---------------------------------------------------------------- Development and tests only
# Never set any of these in production.
# LARRY_ALLOW_NO_CODE=1      AI routes work without an access code (ignored when NODE_ENV=production)
# E2E=1                      the server accepts fake e2e:<uid> sign-in tokens (ignored in production)
# NEXT_PUBLIC_E2E=1          the client uses the fake phone sign-in
# E2E_BASE_URL=https://...   run Playwright against a deployed host
